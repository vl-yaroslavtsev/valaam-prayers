{
  "name": "valaam-prayers",
  "private": true,
  "version": "1.19.1",
  "description": "Валаамский молитвослов и календарь",
  "repository": "",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "nvm": "nvm use 24",
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "dev-local": "cross-env NODE_ENV=development vite --host 172.21.112.50 --port 5173",
    "preview": "cross-env NODE_ENV=development vite preview",
    "clean": "if exist www rmdir /s /q www",
    "build": "npm run clean && cross-env NODE_ENV=production vite build",
    "deploy": "scripts\\deploy.cmd",
    "prod": "npm run build && npm run deploy",
    "pretype-check": "node scripts/generate-icon-types.js",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write src/",
    "postinstall": "cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/ && node scripts/generate-icon-types.js"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "date-fns": "^4.1.0",
    "dom7": "^4.0.6",
    "framework7": "^9.1.2",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^9.1.2",
    "idb": "^8.0.3",
    "lodash-es": "^4.17.21",
    "material-icons": "^1.13.14",
    "pinia": "^4.0.3",
    "skeleton-elements": "^4.0.1",
    "swiper": "^14.1.0",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.16",
    "@vue/typescript-plugin": "^3.3.11",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "less": "^4.3.0",
    "postcss-preset-env": "^11.4.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.0",
    "vue-tsc": "^3.3.11"
  }
}
